    "ai": "6.0.333",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "dexie": "4.4.7",
    "lucide-react": "1.79.0",
    "mermaid": "11.17.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
